+package dev.or2.central
+
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFails
+import kotlin.test.assertSame
+import kotlin.test.assertTrue
+
+class CentralShutdownTest {
+    @Test
+    fun concurrentStopsWaitForProducersAndPersistenceThenCloseDataSourceOnce() {
+        val producerEntered = CountDownLatch(1)
+        val releaseProducer = CountDownLatch(1)
+        val persistenceEntered = CountDownLatch(1)
+        val releasePersistence = CountDownLatch(1)
+        val secondCallerEntered = CountDownLatch(1)
+        val events = CopyOnWriteArrayList<String>()
+        val failures = CopyOnWriteArrayList<Throwable>()
+        val completed = AtomicInteger()
+        val shutdown = CentralShutdown { events.add("datasource") }
+        shutdown.producer {
+            producerEntered.countDown()
+            check(releaseProducer.await(5, TimeUnit.SECONDS))
+            events.add("producer")
+        }
+        shutdown.persistence {
+            persistenceEntered.countDown()
+            check(releasePersistence.await(5, TimeUnit.SECONDS))
+            events.add("persistence")
+        }
+        fun stop() {
+            try {
+                shutdown.stop()
+                completed.incrementAndGet()
+            } catch (failure: Throwable) {
+                failures.add(failure)
+            }
+        }
+        val first = Thread { stop() }
+        val second = Thread {
+            secondCallerEntered.countDown()
+            stop()
+        }
+
+        try {
+            first.start()
+            assertTrue(producerEntered.await(5, TimeUnit.SECONDS))
+            second.start()
+            assertTrue(secondCallerEntered.await(5, TimeUnit.SECONDS))
+            assertTrue(events.isEmpty())
+            assertEquals(0, completed.get())
+            releaseProducer.countDown()
+            assertTrue(persistenceEntered.await(5, TimeUnit.SECONDS))
+            assertEquals(listOf("producer"), events.toList())
+            assertEquals(0, completed.get())
+            releasePersistence.countDown()
+            first.join(5_000)
+            second.join(5_000)
+            assertTrue(failures.isEmpty(), "Unexpected stop failures: $failures")
+            assertEquals(2, completed.get())
+            shutdown.stop()
+            assertEquals(listOf("producer", "persistence", "datasource"), events.toList())
+        } finally {
+            releaseProducer.countDown()
+            releasePersistence.countDown()
+            first.join(5_000)
+            second.join(5_000)
+        }
+    }
+
+    @Test
+    fun producerFailuresAttemptEveryProducerButRetainPersistenceAndDataSource() {
+        val firstFailure = IllegalStateException("listener still active")
+        val lastFailure = IllegalStateException("notifier still active")
+        val events = mutableListOf<String>()
+        val shutdown = CentralShutdown { events.add("datasource") }
+        shutdown.producer {
+            events.add("first")
+            throw firstFailure
+        }
+        shutdown.producer { events.add("second") }
+        shutdown.producer {
+            events.add("third")
+            throw lastFailure
+        }
+        shutdown.persistence { events.add("persistence") }
+
+        val failure = assertFails { shutdown.stop() }
+        assertEquals(listOf("first", "second", "third"), events)
+        assertEquals(listOf(firstFailure, lastFailure), failure.suppressed.toList())
+        assertSame(failure, assertFails { shutdown.stop() })
+        assertEquals(listOf("first", "second", "third"), events, "Repeated stop must not rerun native cleanup")
+    }
+
+    @Test
+    fun persistenceFailureRetainsDataSourceAndTheSameTerminalFailure() {
+        val writeFailure = IllegalStateException("accepted write did not commit")
+        val events = mutableListOf<String>()
+        val shutdown = CentralShutdown { events.add("datasource") }
+        shutdown.producer { events.add("producer") }
+        shutdown.persistence {
+            events.add("persistence")
+            throw writeFailure
+        }
+
+        assertSame(writeFailure, assertFails { shutdown.stop() })
+        assertSame(writeFailure, assertFails { shutdown.stop() })
+        assertEquals(listOf("producer", "persistence"), events)
+    }
+}
