+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class SocialGraphPersistenceShutdownTest {
+    @Test
+    fun flushWaitsForAcceptedWriteToCommit() {
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val jdbc = RecordingJdbc {
+            entered.countDown()
+            check(release.await(5, TimeUnit.SECONDS)) { "Test did not release JDBC write" }
+        }
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 5_000)
+        val flushFailure = AtomicReference<Throwable?>()
+        val flushed = CountDownLatch(1)
+        val stopper = Thread {
+            try {
+                persistence.flush()
+            } catch (failure: Throwable) {
+                flushFailure.set(failure)
+            } finally {
+                flushed.countDown()
+            }
+        }
+
+        try {
+            persistence.enqueueFriendAdd(11, 22)
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            stopper.start()
+            assertTrue(executor.awaitEntered.await(5, TimeUnit.SECONDS))
+            assertEquals(1L, flushed.count, "Flush returned while the accepted write was still active")
+            assertTrue(jdbc.committed.isEmpty())
+            release.countDown()
+            assertTrue(flushed.await(5, TimeUnit.SECONDS))
+            assertEquals(null, flushFailure.get())
+            assertEquals(listOf(Write("friend-add", listOf(11, 22))), jdbc.committed.toList())
+            assertTrue(executor.isTerminated)
+        } finally {
+            release.countDown()
+            stopExecutor(executor)
+            stopper.join(5_000)
+        }
+    }
+
+    @Test
+    fun databaseFailureRemainsVisibleAcrossFlushCallsWithoutRetry() {
+        val databaseFailure = SQLException("deliberate database write failure")
+        val attempted = CopyOnWriteArrayList<Write>()
+        val jdbc = RecordingJdbc { write ->
+            attempted.add(write)
+            throw databaseFailure
+        }
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 5_000)
+
+        try {
+            persistence.enqueueFriendAdd(11, 22)
+            val first = assertFails { persistence.flush() }
+            val second = assertFails { persistence.flush() }
+            assertTrue(first.containsFailure(databaseFailure), "Flush must expose the original database failure")
+            assertTrue(second.containsFailure(databaseFailure), "A repeated flush must retain the failure")
+            assertEquals(listOf(Write("friend-add", listOf(11, 22))), attempted.toList())
+            assertTrue(jdbc.committed.isEmpty())
+            assertEquals(0, executor.forcedShutdowns)
+        } finally {
+            stopExecutor(executor)
+        }
+    }
+
+    @Test
+    fun timeoutPreservesActiveAndQueuedWritesUntilTheyCanComplete() {
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val interrupted = AtomicBoolean()
+        val jdbc = blockedJdbc(entered, release, interrupted)
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 1)
+
+        try {
+            persistence.enqueueFriendAdd(11, 22)
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            persistence.enqueueFriendDelete(11, 22)
+            assertFails { persistence.flush() }
+            assertEquals(0, executor.forcedShutdowns)
+            assertFalse(interrupted.get())
+            assertFalse(executor.isTerminated)
+            assertEquals(1, executor.queue.size, "The accepted queued write must remain in the executor")
+            release.countDown()
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS))
+            assertEquals(
+                listOf(Write("friend-add", listOf(11, 22)), Write("friend-delete", listOf(11, 22))),
+                jdbc.committed.toList(),
+            )
+        } finally {
+            release.countDown()
+            stopExecutor(executor)
+        }
+    }
+
+    @Test
+    fun interruptedFlushPreservesInterruptAndAcceptedWrites() {
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val workerInterrupted = AtomicBoolean()
+        val jdbc = blockedJdbc(entered, release, workerInterrupted)
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 5_000)
+        val flushFailure = AtomicReference<Throwable?>()
+        val interruptPreserved = AtomicBoolean()
+        val stopper = Thread {
+            Thread.currentThread().interrupt()
+            try {
+                persistence.flush()
+            } catch (failure: Throwable) {
+                flushFailure.set(failure)
+            } finally {
+                interruptPreserved.set(Thread.currentThread().isInterrupted)
+            }
+        }
+
+        try {
+            persistence.enqueueFriendAdd(11, 22)
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            persistence.enqueueIgnoreAdd(11, 33)
+            stopper.start()
+            stopper.join(5_000)
+            assertFalse(stopper.isAlive)
+            assertTrue(flushFailure.get() != null, "Interrupted drain must fail visibly")
+            assertTrue(interruptPreserved.get())
+            assertEquals(0, executor.forcedShutdowns)
+            assertFalse(workerInterrupted.get())
+            assertEquals(1, executor.queue.size)
+            release.countDown()
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS))
+            assertEquals(
+                listOf(Write("friend-add", listOf(11, 22)), Write("ignore-add", listOf(11, 33))),
+                jdbc.committed.toList(),
+            )
+        } finally {
+            release.countDown()
+            stopExecutor(executor)
+            stopper.join(5_000)
+        }
+    }
+
+    @Test
+    fun enqueueAfterShutdownFailsWithoutAcceptingWrite() {
+        val jdbc = RecordingJdbc()
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 5_000)
+
+        try {
+            persistence.flush()
+            assertFailsWith<RejectedExecutionException> { persistence.enqueueFriendAdd(11, 22) }
+            assertTrue(jdbc.committed.isEmpty())
+            assertTrue(executor.queue.isEmpty())
+        } finally {
+            stopExecutor(executor)
+        }
+    }
+
+    @Test
+    fun everyOperationPersistsInSubmissionOrderWithItsOriginalArguments() {
+        val jdbc = RecordingJdbc()
+        val executor = TrackingExecutor()
+        val persistence = SocialGraphPersistence(CentralSocialRepository(jdbc.dataSource), executor, 5_000)
+
+        try {
+            persistence.enqueueFriendAdd(11, 22)
+            persistence.enqueueFriendDelete(11, 22)
+            persistence.enqueueIgnoreAdd(11, 33)
+            persistence.enqueueIgnoreDelete(11, 33)
+            persistence.enqueuePrivateChatFilter(11, 2)
+            persistence.flush()
+            assertEquals(
+                listOf(
+                    Write("friend-add", listOf(11, 22)),
+                    Write("friend-delete", listOf(11, 22)),
+                    Write("ignore-add", listOf(11, 33)),
+                    Write("ignore-delete", listOf(11, 33)),
+                    Write("private-chat", listOf(11, 2)),
+                ),
+                jdbc.committed.toList(),
+            )
+            assertEquals(0, executor.forcedShutdowns)
+        } finally {
+            stopExecutor(executor)
+        }
+    }
+
+    private fun blockedJdbc(
+        entered: CountDownLatch,
+        release: CountDownLatch,
+        interrupted: AtomicBoolean,
+    ): RecordingJdbc = RecordingJdbc { write ->
+        if (write.operation == "friend-add") {
+            entered.countDown()
+            try {
+                check(release.await(5, TimeUnit.SECONDS)) { "Test did not release JDBC write" }
+            } catch (failure: InterruptedException) {
+                interrupted.set(true)
+                throw failure
+            }
+        }
+    }
+
+    private fun stopExecutor(executor: TrackingExecutor) {
+        executor.shutdown()
+        assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS), "Test executor did not terminate")
+    }
+
+    private fun Throwable.containsFailure(expected: Throwable): Boolean =
+        this === expected || cause?.containsFailure(expected) == true || suppressed.any { it.containsFailure(expected) }
+
+    private data class Write(val operation: String, val arguments: List<Int>)
+
+    /** Returning from executeUpdate represents the repository's auto-committed JDBC write. */
+    private class RecordingJdbc(private val beforeCommit: (Write) -> Unit = {}) {
+        val committed = CopyOnWriteArrayList<Write>()
+        val dataSource: DataSource = proxy(DataSource::class.java) { name, _ ->
+            when (name) {
+                "getConnection" -> connection()
+                else -> error("Unexpected DataSource.$name")
+            }
+        }
+
+        private fun connection(): Connection = proxy(Connection::class.java) { name, arguments ->
+            when (name) {
+                "prepareStatement" -> statement(arguments[0] as String)
+                "close" -> null
+                else -> error("Unexpected Connection.$name")
+            }
+        }
+
+        private fun statement(sql: String): PreparedStatement {
+            val parameters = sortedMapOf<Int, Int>()
+            val operation = when {
+                sql.startsWith("INSERT INTO character_friends") -> "friend-add"
+                sql.startsWith("DELETE FROM character_friends") -> "friend-delete"
+                sql.startsWith("INSERT INTO character_ignores") -> "ignore-add"
+                sql.startsWith("DELETE FROM character_ignores") -> "ignore-delete"
+                sql.startsWith("INSERT INTO character_chat_filters") -> "private-chat"
+                else -> error("Unexpected write SQL: $sql")
+            }
+            return proxy(PreparedStatement::class.java) { name, arguments ->
+                when (name) {
+                    "setInt" -> {
+                        parameters[arguments[0] as Int] = arguments[1] as Int
+                        null
+                    }
+                    "executeUpdate" -> {
+                        val write = Write(operation, parameters.values.toList())
+                        beforeCommit(write)
+                        committed.add(write)
+                        1
+                    }
+                    "close" -> null
+                    else -> error("Unexpected PreparedStatement.$name")
+                }
+            }
+        }
+
+        private fun <T : Any> proxy(type: Class<T>, call: (String, Array<out Any?>) -> Any?): T =
+            type.cast(
+                Proxy.newProxyInstance(type.classLoader, arrayOf(type)) { _, method, arguments ->
+                    call(method.name, arguments ?: emptyArray())
+                },
+            )
+    }
+
+    private class TrackingExecutor : ThreadPoolExecutor(
+        1,
+        1,
+        0,
+        TimeUnit.MILLISECONDS,
+        LinkedBlockingQueue(),
+        { task -> Thread(task, "social-persistence-test").apply { isDaemon = true } },
+    ) {
+        val awaitEntered = CountDownLatch(1)
+        var forcedShutdowns = 0
+            private set
+
+        override fun awaitTermination(timeout: Long, unit: TimeUnit): Boolean {
+            awaitEntered.countDown()
+            return super.awaitTermination(timeout, unit)
+        }
+
+        override fun shutdownNow(): MutableList<Runnable> {
+            forcedShutdowns++
+            return super.shutdownNow()
+        }
+    }
+}
