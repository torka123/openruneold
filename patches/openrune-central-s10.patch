+                callersReady.countDown()
+                check(releaseCallers.await(5, TimeUnit.SECONDS))
+                try {
+                    server.stop()
+                } catch (failure: Throwable) {
+                    failures.add(failure)
+                }
+            }
+        }
+
+        try {
+            server.start()
+            callers.forEach(Thread::start)
+            assertTrue(callersReady.await(5, TimeUnit.SECONDS))
+            releaseCallers.countDown()
+            callers.forEach { it.join(10_000) }
+            assertTrue(callers.none(Thread::isAlive))
+            assertEquals(2, failures.size, "Ktor must not swallow the cleanup result observed by embedded stop")
+            failures.forEach { assertSame(writeFailure, it) }
+            assertSame(writeFailure, assertFails { server.stop() })
+            assertEquals(1, stoppedEvents.get(), "The actual Ktor stopped event must have run")
+            assertEquals(listOf("producer", "persistence"), events.toList())
+        } finally {
+            releaseCallers.countDown()
+            callers.forEach { it.join(10_000) }
+            runCatching { server.stop() }
+        }
+    }
+
+    @Test
+    fun partialConfigurationFailureRetainsCreatedOwnersForExplicitStop() {
+        val startupFailure = IllegalStateException("configuration failed after owner creation")
+        val events = CopyOnWriteArrayList<String>()
+        val server = server(
+            configure = { application ->
+                val shutdown = CentralShutdown { events.add("datasource") }
+                CentralShutdown.install(application, shutdown)
+                shutdown.producer { events.add("created-producer") }
+                // No stopped subscriber is installed before this partial configuration failure.
+                throw startupFailure
+            },
+            stopPostgres = { events.add("postgres") },
+        )
+
+        try {
+            val failure = assertFails { server.start() }
+            assertTrue(failure.containsFailure(startupFailure))
+            assertFalse(events.contains("postgres"))
+            server.stop()
+            server.stop()
+            assertEquals(listOf("created-producer", "datasource", "postgres"), events.toList())
+        } finally {
+            runCatching { server.stop() }
+        }
+    }
+
+    private fun server(
+        configure: (Application) -> Unit,
+        stopPostgres: () -> Unit,
+    ): CentralEmbeddedServer = CentralEmbeddedServer(
+        config = CentralConfig(http = HttpConfig(port = 0)),
+        resolveConfig = { it to true },
+        configureApplication = { application, _ -> configure(application) },
+        stopPostgres = stopPostgres,
+    )
+
+    private fun Throwable.containsFailure(expected: Throwable): Boolean =
+        this === expected || cause?.containsFailure(expected) == true || suppressed.any { it.containsFailure(expected) }
+
+    private class OwnedProducer(private val stopAction: () -> Unit) {
+        fun stop() = stopAction()
+    }
+}
