diff --git a/central-app/src/main/kotlin/dev/or2/central/CentralShutdown.kt b/central-app/src/main/kotlin/dev/or2/central/CentralShutdown.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1a29fe84dc8f68c49cd50237c38ff7771276557c
--- /dev/null
+++ b/central-app/src/main/kotlin/dev/or2/central/CentralShutdown.kt
@@ -0,0 +1,79 @@
+package dev.or2.central
+
+import io.ktor.server.application.Application
+import io.ktor.util.AttributeKey
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.TimeUnit
+
+/** Owns the already-created services even after Koin disposes its instance registry. */
+internal class CentralShutdown(private val closeDataSource: () -> Unit) {
+    private val producers = mutableListOf<() -> Unit>()
+    private var persistence: (() -> Unit)? = null
+    private var result: Result<Unit>? = null
+
+    @Synchronized
+    fun producer(stop: () -> Unit) {
+        check(result == null) { "Central shutdown already completed" }
+        producers += stop
+    }
+
+    @Synchronized
+    fun persistence(flush: () -> Unit) {
+        check(result == null && persistence == null)
+        persistence = flush
+    }
+
+    /** Repeated/concurrent callers observe the same completed result, including failure. */
+    @Synchronized
+    fun stop() {
+        result?.let { return it.getOrThrow() }
+        val completed = runCatching {
+            val failures = mutableListOf<Throwable>()
+            for (stop in producers) {
+                try {
+                    stop()
+                } catch (failure: Throwable) {
+                    failures += failure
+                }
+            }
+            if (failures.isNotEmpty()) {
+                val failure = IllegalStateException(
+                    "Central producers did not stop; persistence and datasource retained",
+                )
+                failures.forEach(failure::addSuppressed)
+                throw failure
+            }
+            persistence?.invoke()
+            closeDataSource()
+        }
+        result = completed
+        completed.getOrThrow()
+    }
+
+    companion object {
+        private val key = AttributeKey<CentralShutdown>("OpenRuneCentralShutdown")
+
+        fun install(application: Application, shutdown: CentralShutdown) {
+            application.attributes.put(key, shutdown)
+        }
+
+        fun stop(application: Application) {
+            owner(application)?.stop()
+        }
+
+        fun owner(application: Application): CentralShutdown? = application.attributes.getOrNull(key)
+    }
+}
+
+/** Bounded observation only: a timeout must not interrupt/discard accepted work. */
+internal fun ExecutorService.finishShutdown(timeoutMillis: Long = 15_000) {
+    shutdown()
+    try {
+        check(awaitTermination(timeoutMillis, TimeUnit.MILLISECONDS)) {
+            "Central executor has unfinished work; datasource retained"
+        }
+    } catch (failure: InterruptedException) {
+        Thread.currentThread().interrupt()
+        throw failure
+    }
+}
