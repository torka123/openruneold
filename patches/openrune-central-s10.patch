+    @Test
+    fun eventSubscriberFailureEscapesEveryConcurrentAndRepeatedStopWithoutClosingPostgres() {
+        val writeFailure = IllegalStateException("social write did not commit")
+        val events = CopyOnWriteArrayList<String>()
+        val stoppedEvents = AtomicInteger()
