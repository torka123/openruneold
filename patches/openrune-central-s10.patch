+package dev.or2.central
+
+import dev.or2.central.config.WorldLinkConfig
+import dev.or2.central.notify.PgNotifyHandler
+import dev.or2.central.notify.PgNotifyService
+import dev.or2.central.worldlink.WorldConnectionRegistry
+import dev.or2.central.worldlink.WorldLinkHandler
+import dev.or2.central.worldlink.net.WorldLinkServer
+import io.netty.channel.Channel
+import io.netty.channel.nio.NioEventLoopGroup
+import java.lang.reflect.Proxy
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.sql.Connection
+import java.sql.Statement
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
+import javax.sql.DataSource
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFails
+import kotlin.test.assertFalse
+import kotlin.test.assertIs
+import kotlin.test.assertSame
+import kotlin.test.assertTrue
+import org.mockito.Mockito.mock
+import org.mockito.Answers
+import org.postgresql.PGConnection
+import org.postgresql.PGNotification
+
+class CentralProducerShutdownTest {
+    @Test
+    fun worldLinkStopRetainsNativeChannelFinalizationFailureWithoutRetryingIt() {
+        val finalizationFailure = IllegalStateException("world presence write failed")
+        val finalized = CountDownLatch(1)
+        val finalizationAttempts = AtomicInteger()
+        val handler = mock(WorldLinkHandler::class.java) { invocation ->
+            if (invocation.method.name == "onChannelClosed") {
+                finalizationAttempts.incrementAndGet()
+                finalized.countDown()
+                throw finalizationFailure
+            }
+            Answers.RETURNS_DEFAULTS.answer(invocation)
+        }
+        val server = WorldLinkServer(WorldLinkConfig(port = 0), handler, WorldConnectionRegistry())
+
+        try {
+            server.start()
+            val listener = field<Channel>(server, "serverChannel")
+            val port = (listener.localAddress() as InetSocketAddress).port
+            Socket().use { client ->
+                client.connect(InetSocketAddress("127.0.0.1", port), 5_000)
+            }
+            assertTrue(finalized.await(5, TimeUnit.SECONDS))
+            val failure = assertFails { server.stop() }
+            assertEquals(listOf(finalizationFailure), failure.suppressed.toList())
+            assertTrue(field<NioEventLoopGroup>(server, "bossGroup").isTerminated)
+            assertTrue(field<NioEventLoopGroup>(server, "workerGroup").isTerminated)
+            val repeated = assertFails { server.stop() }
+            assertEquals(listOf(finalizationFailure), repeated.suppressed.toList())
+            assertEquals(1, finalizationAttempts.get())
+        } finally {
+            runCatching { server.stop() }
+        }
+    }
+
+    @Test
+    fun worldLinkStopWaitsForNativeWorkerCallbacksAndTerminatesBothGroups() {
+        val server = WorldLinkServer(
+            WorldLinkConfig(port = 0),
+            mock(WorldLinkHandler::class.java),
+            WorldConnectionRegistry(),
+        )
+        val boss = field<NioEventLoopGroup>(server, "bossGroup")
+        val workers = field<NioEventLoopGroup>(server, "workerGroup")
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val stopped = CountDownLatch(1)
+        val stopFailure = AtomicReference<Throwable?>()
+        val events = CopyOnWriteArrayList<String>()
+        val stopper = Thread {
+            try {
+                server.stop()
+                events.add("stopped")
+            } catch (failure: Throwable) {
+                stopFailure.set(failure)
+            } finally {
+                stopped.countDown()
+            }
+        }
+
+        try {
+            server.start()
+            val listener = field<Channel>(server, "serverChannel")
+            assertTrue((listener.localAddress() as InetSocketAddress).port > 0)
+            val worker = workers.next()
+            worker.execute {
+                callbackEntered.countDown()
+                check(releaseCallback.await(10, TimeUnit.SECONDS))
+                events.add("active-callback")
+            }
+            assertTrue(callbackEntered.await(5, TimeUnit.SECONDS))
+            worker.execute { events.add("queued-callback") }
+            stopper.start()
+            assertTrue(listener.closeFuture().await(5, TimeUnit.SECONDS))
+            assertTrue(boss.terminationFuture().await(5, TimeUnit.SECONDS))
+            assertFalse(workers.isTerminated)
+            assertEquals(1L, stopped.count, "World-link stop returned with an active native callback")
+            releaseCallback.countDown()
+            assertTrue(stopped.await(10, TimeUnit.SECONDS))
+            assertEquals(null, stopFailure.get())
+            assertFalse(listener.isOpen)
+            assertTrue(boss.isTerminated)
+            assertTrue(workers.isTerminated)
+            assertEquals(listOf("active-callback", "queued-callback", "stopped"), events.toList())
+        } finally {
+            releaseCallback.countDown()
+            stopper.join(20_000)
+            server.stop()
+        }
+    }
+
+    @Test
+    fun notifierStopWaitsForActiveCallbackAndClosesItsConnection() {
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val stopped = CountDownLatch(1)
+        val events = CopyOnWriteArrayList<String>()
+        val stopFailure = AtomicReference<Throwable?>()
+        val jdbc = NotifyJdbc()
+        val service = PgNotifyService(
+            jdbc.dataSource,
+            mapOf("shutdown_test" to PgNotifyHandler {
+                assertEquals("payload", it)
+                callbackEntered.countDown()
+                awaitCallbackRelease(releaseCallback)
+                events.add("callback-complete")
+            }),
+        )
+        val stopper = Thread {
+            try {
+                service.stop()
+                events.add("stopped")
+            } catch (failure: Throwable) {
+                stopFailure.set(failure)
+            } finally {
+                stopped.countDown()
+            }
+        }
+
+        try {
+            service.start()
+            assertTrue(callbackEntered.await(5, TimeUnit.SECONDS))
+            val worker = field<Thread>(service, "thread")
+            stopper.start()
+            assertTrue(jdbc.connectionClosed.await(5, TimeUnit.SECONDS))
+            assertTrue(worker.isAlive)
+            assertEquals(1L, stopped.count, "Notifier stop returned before its callback completed")
+            releaseCallback.countDown()
+            assertTrue(stopped.await(5, TimeUnit.SECONDS))
+            assertEquals(null, stopFailure.get())
+            assertFalse(worker.isAlive)
+            assertEquals(listOf("callback-complete", "stopped"), events.toList())
+            assertEquals(null, field<Thread?>(service, "thread"))
+        } finally {
+            releaseCallback.countDown()
+            stopper.join(20_000)
+            service.stop()
+        }
+    }
+
+    @Test
+    fun notifierStopLetsAnInterruptibleAcceptedCallbackFinishNaturally() {
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val callbackCompleted = AtomicBoolean()
+        val callbackInterrupted = AtomicBoolean()
+        val stopped = CountDownLatch(1)
+        val stopFailure = AtomicReference<Throwable?>()
+        val jdbc = NotifyJdbc()
+        val service = PgNotifyService(
+            jdbc.dataSource,
+            mapOf("shutdown_test" to PgNotifyHandler {
+                callbackEntered.countDown()
+                try {
+                    check(releaseCallback.await(10, TimeUnit.SECONDS))
+                    callbackCompleted.set(true)
+                } catch (failure: InterruptedException) {
+                    callbackInterrupted.set(true)
+                    throw failure
+                }
+            }),
+        )
+        val stopper = Thread {
+            try {
+                service.stop()
+            } catch (failure: Throwable) {
+                stopFailure.set(failure)
+            } finally {
+                stopped.countDown()
+            }
+        }
+
+        try {
+            service.start()
+            assertTrue(callbackEntered.await(5, TimeUnit.SECONDS))
+            val worker = field<Thread>(service, "thread")
+            stopper.start()
+            assertTrue(jdbc.connectionClosed.await(5, TimeUnit.SECONDS))
+            assertTrue(worker.isAlive)
+            assertEquals(1L, stopped.count, "Stop must wait for the accepted callback")
+            assertFalse(callbackInterrupted.get(), "Stop must not interrupt accepted callback work")
+            releaseCallback.countDown()
+            assertTrue(stopped.await(5, TimeUnit.SECONDS))
+            assertEquals(null, stopFailure.get())
+            assertTrue(callbackCompleted.get())
+            assertFalse(callbackInterrupted.get())
+            assertFalse(worker.isAlive)
+        } finally {
+            releaseCallback.countDown()
+            stopper.join(20_000)
+            service.stop()
+        }
+    }
+
+    @Test
+    fun interruptedNotifierStopReportsFailureAndRetainsLiveWorkerUntilItCompletes() {
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val callbackCompleted = AtomicBoolean()
+        val callerInterrupted = AtomicBoolean()
+        val stopFailure = AtomicReference<Throwable?>()
+        val jdbc = NotifyJdbc()
+        val service = PgNotifyService(
+            jdbc.dataSource,
+            mapOf("shutdown_test" to PgNotifyHandler {
+                callbackEntered.countDown()
+                awaitCallbackRelease(releaseCallback)
+                callbackCompleted.set(true)
+            }),
+        )
+        val stopper = Thread {
+            Thread.currentThread().interrupt()
+            try {
+                service.stop()
+            } catch (failure: Throwable) {
+                stopFailure.set(failure)
+            } finally {
+                callerInterrupted.set(Thread.currentThread().isInterrupted)
+            }
+        }
+
+        try {
+            service.start()
+            assertTrue(callbackEntered.await(5, TimeUnit.SECONDS))
+            val worker = field<Thread>(service, "thread")
+            stopper.start()
+            stopper.join(5_000)
+            assertFalse(stopper.isAlive)
+            assertIs<InterruptedException>(stopFailure.get())
+            assertTrue(callerInterrupted.get())
+            assertEquals(0L, jdbc.connectionClosed.count)
+            assertTrue(worker.isAlive)
+            assertSame(worker, field<Thread>(service, "thread"))
+            assertFalse(callbackCompleted.get())
+            releaseCallback.countDown()
+            service.stop()
+            assertTrue(callbackCompleted.get())
+            assertFalse(worker.isAlive)
+            assertEquals(null, field<Thread?>(service, "thread"))
+        } finally {
+            releaseCallback.countDown()
+            stopper.join(20_000)
+            service.stop()
+        }
+    }
+
+    /** Model a callback already completing work that cannot be cancelled by the notifier's interrupt. */
+    private fun awaitCallbackRelease(release: CountDownLatch) {
+        var interrupted = false
+        try {
+            while (true) {
+                try {
+                    check(release.await(10, TimeUnit.SECONDS)) { "Test callback was not released" }
+                    return
+                } catch (_: InterruptedException) {
+                    interrupted = true
+                }
+            }
+        } finally {
+            if (interrupted) Thread.currentThread().interrupt()
+        }
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    private fun <T> field(owner: Any, name: String): T =
+        owner.javaClass.getDeclaredField(name).apply { isAccessible = true }.get(owner) as T
+
+    private class NotifyJdbc {
+        val connectionClosed = CountDownLatch(1)
+        private val delivered = AtomicBoolean()
+        private val notification = proxy(PGNotification::class.java) { name, _ ->
+            when (name) {
+                "getName" -> "shutdown_test"
+                "getParameter" -> "payload"
+                "getPID" -> 1
+                else -> error("Unexpected PGNotification.$name")
+            }
+        }
+        private val pgConnection = proxy(PGConnection::class.java) { name, _ ->
+            when (name) {
+                "getNotifications" -> if (delivered.compareAndSet(false, true)) arrayOf(notification) else null
+                else -> error("Unexpected PGConnection.$name")
+            }
+        }
+        private val connection = proxy(Connection::class.java) { name, _ ->
+            when (name) {
+                "setAutoCommit" -> null
+                "unwrap" -> pgConnection
+                "createStatement" -> statement()
+                "close" -> {
+                    connectionClosed.countDown()
+                    null
+                }
+                else -> error("Unexpected Connection.$name")
+            }
+        }
+        val dataSource: DataSource = proxy(DataSource::class.java) { name, _ ->
+            when (name) {
+                "getConnection" -> connection
+                else -> error("Unexpected DataSource.$name")
+            }
+        }
+
+        private fun statement(): Statement = proxy(Statement::class.java) { name, _ ->
+            when (name) {
+                "addBatch", "close" -> null
+                "executeBatch" -> intArrayOf(0)
+                "execute" -> true
+                else -> error("Unexpected Statement.$name")
+            }
+        }
+
+        private fun <T : Any> proxy(type: Class<T>, call: (String, Array<out Any?>) -> Any?): T =
+            type.cast(
+                Proxy.newProxyInstance(type.classLoader, arrayOf(type)) { _, method, arguments ->
+                    call(method.name, arguments ?: emptyArray())
+                },
+            )
+    }
+}
